{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    {
      "path": "pages/landing/index",
      "style": {
        "navigationStyle": "custom",
        "backgroundColor": "#F5F6FA",
        "backgroundColorTop": "#FFFFFF",
        "backgroundColorBottom": "#F5F6FA"
      }
    },
    {
      "path": "pages/nearby/index",
      "style": {
        "navigationStyle": "custom",
        "backgroundColor": "#F5F6FA",
        "backgroundColorTop": "#FFFFFF",
        "backgroundColorBottom": "#F5F6FA"
      }
    },
    {
      "path": "pages/history/index",
      "style": {
        "navigationStyle": "custom",
        "enablePullDownRefresh": true,
        "backgroundColor": "#F5F6FA",
        "backgroundColorTop": "#FFFFFF",
        "backgroundColorBottom": "#F5F6FA"
      }
    },
    {
      "path": "pages/profile/index",
      "style": {
        "navigationStyle": "custom",
        "backgroundColor": "#F5F6FA",
        "backgroundColorTop": "#FFFFFF",
        "backgroundColorBottom": "#F5F6FA"
      }
    },
  ],
  "subPackages": [
    {
      "root": "pages/result",
      "pages": [
        {
          "path": "index",
          "style": { "navigationStyle": "custom", "backgroundColor": "#F5F6FA" }
        }
      ]
    },
    {
      "root": "pages/chat",
      "pages": [
        {
          "path": "index",
          "style": { "navigationStyle": "custom", "backgroundColor": "#F5F6FA" }
        }
      ]
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarBackgroundColor": "#FFFFFF",
    "backgroundColor": "#F5F6FA",
    "backgroundTextStyle": "dark"
  },
  "tabBar": {
    "color": "#9CA3AF",
    "selectedColor": "#FF6B35",
    "backgroundColor": "#FFFFFF",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/landing/index",
        "text": "长途",
        "iconPath": "static/tab-plan.png",
        "selectedIconPath": "static/tab-plan-active.png"
      },
      {
        "pagePath": "pages/nearby/index",
        "text": "附近",
        "iconPath": "static/tab-nearby.png",
        "selectedIconPath": "static/tab-nearby-active.png"
      },
      {
        "pagePath": "pages/history/index",
        "text": "行程",
        "iconPath": "static/tab-trip.png",
        "selectedIconPath": "static/tab-trip-active.png"
      },
      {
        "pagePath": "pages/profile/index",
        "text": "我的",
        "iconPath": "static/tab-profile.png",
        "selectedIconPath": "static/tab-profile-active.png"
      }
    ]
  }
}
